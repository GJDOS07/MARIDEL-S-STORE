DATABASE_URL=REPLACE_WITH_YOUR_DATABASE_CONNECTION_STRING
# Owner authentication. Both are required, and the backend refuses to log anyone
# in until both are present and well formed, so a service that starts is not
# necessarily a service you can log into.
#
# Generate both with: npm run set-owner-password -- --write-env
# Check the current state with: npm run check-owner-config
#
# Format of the hash: scrypt$<32+ hex salt>$<128 hex hash>. Copy it with no
# surrounding whitespace; a trailing newline is rejected and login then fails.
OWNER_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH_FROM_npm run set-owner-password
# At least 32 characters. A fresh one is generated whenever none is present.
OWNER_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_ORIGINS=https://gjdos07.github.io
# Local development only: uncomment to allow local storefront origins.
# FRONTEND_ORIGINS=https://gjdos07.github.io,http://localhost:5500,http://127.0.0.1:5500

# --- Local sandbox database (development only) --------------------------------
# Set to 1 to run against an isolated in-process PostgreSQL built from this
# project's own migrations and a synthetic catalog. Nothing is contacted over the
# network and no production row is read or written.
#
# Use this whenever your DATABASE_URL points at production, which is how a stray
# local run avoids reading and changing production data.
LOCAL_SANDBOX_DB=1

# --- Product photo storage ----------------------------------------------------
# Where uploaded product photos are written. MUST be a durable directory attached
# to the running service, because the free Render tier wipes the local disk on
# every restart and redeploy.
#
# Set this to a mounted disk path (e.g. /var/data/product-images on render.com)
# or leave it unset, in which case uploads are refused with a clear 503 rather
# than silently saved somewhere that will vanish.
# PRODUCT_IMAGE_DIR=REPLACE_WITH_A_DURABLE_DIRECTORY
# Body limit for the base64 upload, which is about a third larger than the file.
# 8mb covers a 5MB image with headroom; the decoded size is still checked at 5MB.
PRODUCT_IMAGE_BODY_LIMIT=8mb

# --- Owner password reset by email (optional) ---------------------------------
# Reset links are sent with Resend, whose free tier allows 3,000 emails a month
# and 100 a day. All four are needed before a link can be sent; if any is
# missing, reset requests are answered generically and no token is issued.
#
#   1. Create a free account at https://resend.com and add an API key.
#   2. Add and verify a sending domain (Resend gives you the DNS records to add
#      at your registrar, or use the onboarding address on a verified domain).
#   3. Set OWNER_RESET_FROM_EMAIL to that verified "Name <address>" value.
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
OWNER_RESET_FROM_EMAIL=REPLACE_WITH_A_VERIFIED_SENDER_ADDRESS
# The ONLY address a reset link is ever sent to. It is read from configuration
# here, never from the request body, so a caller cannot redirect the link.
OWNER_CONTACT_EMAIL=owner@example.com
# The base of the reset link. Must be https in production: a link over plaintext
# would expose the token.
OWNER_RESET_BASE_URL=https://gjdos07.github.io/MARIDEL-S-STORE
# How long a reset link stays valid, in minutes. Capped at 24 hours.
OWNER_RESET_TTL_MINUTES=30

# Legacy admin password is obsolete; owner auth uses OWNER_PASSWORD_HASH + OWNER_SESSION_SECRET.
# ADMIN_PASSWORD is retained only for historical reference and must not be used by new code.
# ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
